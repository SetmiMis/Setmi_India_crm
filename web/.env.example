# SETMI INDIA CRM — environment template. Copy to .env.local (development) or set in the
# hosting panel (production). NEVER commit real values. Only NEXT_PUBLIC_* reach browsers.

# --- Supabase (Project Settings → API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key (sb_publishable_...) — safe in the browser because RLS protects every table.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) — SERVER ONLY. Bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Public URL of this app, used in password-reset links, share links and emails.
# The production subdomain is NOT decided yet — set it at deploy time.
APP_BASE_URL=http://localhost:3000

# Random string (32+ chars) used to hash IPs for rate limiting. Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_SALT=

# Bearer secret for /api/cron/* (daily digest, Meta import). Leave empty to disable those endpoints.
CRON_SECRET=

# When "true", admins must enrol an authenticator app (TOTP) before using admin pages.
REQUIRE_ADMIN_MFA=false

# --- OMS bridge (optional; same values as the legacy Apps Script properties) ---
OMS_URL=
OMS_INGEST_TOKEN=
OMS_TIMEOUT_MS=15000

# --- SMTP for the daily digest (optional; e.g. a Hostinger mailbox) ---
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="SETMI INDIA CRM <crm@example.com>"

# --- Meta Ads leads Google Sheet (optional) ---
# Share the sheet (Viewer) with the service account email below.
META_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private key with literal \n for line breaks.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Origin allowed to call /api/public/metrics from a browser (e.g. https://www.setmiindia.org). Optional.
PUBLIC_METRICS_ORIGIN=

# Map tiles (OpenStreetMap by default; respect its usage policy or use a paid provider).
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
